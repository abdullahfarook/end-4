[Unit]
Description=Let the linuwu_sense group set Acer fan speeds
After=damx-daemon.service
Wants=damx-daemon.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for i in $(seq 30); do [ -e /sys/devices/platform/acer-wmi/nitro_sense/fan_speed ] && break; sleep 1; done; chgrp linuwu_sense /sys/devices/platform/acer-wmi/nitro_sense/fan_speed && chmod 664 /sys/devices/platform/acer-wmi/nitro_sense/fan_speed'

[Install]
WantedBy=multi-user.target
