+	// messages.getHtml fetches the original HTML of one message on demand from
+	// the provider (never stored). Params: threadId (local), optional messageId
+	// (local; default the newest received message). Result: {messageId, html, text, subject}.
+	srv.Register("messages.getHtml", func(ctx context.Context, p map[string]any) (any, error) {
+		tid, err := intParam(p, "threadId")
+		if err != nil {
+			return nil, err
+		}
+		t, err := d.repo.GetThread(ctx, tid)
+		if err != nil {
+			return nil, err
+		}
+		var msg *models.MessageView
+		want, _ := intParam(p, "messageId")
+		for i := len(t.Messages) - 1; i >= 0; i-- {
+			m := &t.Messages[i]
+			if (want != 0 && m.ID == want) || (want == 0 && !m.IsSent) {
+				msg = m
+				break
+			}
+		}
+		if msg == nil && len(t.Messages) > 0 {
+			msg = &t.Messages[len(t.Messages)-1]
+		}
+		if msg == nil {
+			return map[string]any{"messageId": 0, "html": "", "text": "", "subject": t.Subject}, nil
+		}
+		accID, err := parseUUID(t.AccountID)
+		if err != nil {
+			return nil, err
+		}
+		prov, ok := d.registry.Provider(accID)
+		if !ok {
+			return nil, fmt.Errorf("account not available")
+		}
+		f, ok := prov.(provider.HTMLFetcher)
+		if !ok {
+			return map[string]any{"messageId": msg.ID, "html": "", "text": msg.BodyText, "subject": t.Subject}, nil
+		}
+		html, err := f.MessageHTML(ctx, t.ProviderThreadID, msg.ProviderMessageID)
+		if err != nil {
+			return nil, err
+		}
+		return map[string]any{"messageId": msg.ID, "html": html, "text": msg.BodyText, "subject": t.Subject}, nil
+	})
