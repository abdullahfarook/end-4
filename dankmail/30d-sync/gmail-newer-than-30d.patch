+// MessageHTML returns the original text/html part of one message ("" when
+// the message is plain text only). Fetched on demand, never stored.
+func (p *Provider) MessageHTML(ctx context.Context, threadID, messageID string) (string, error) {
+	t, err := p.api.GetThread(ctx, threadID)
+	if err != nil {
+		return "", classify(err)
+	}
+	for _, m := range t.Messages {
+		if m.Id == messageID {
+			return firstHTML(m.Payload), nil
+		}
+	}
+	return "", nil
+}
