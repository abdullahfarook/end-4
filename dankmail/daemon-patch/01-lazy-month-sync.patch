+
+// HistoryPager loads one older time window of the inbox per call. Tokens are
+// opaque; "" starts from the oldest already-synced boundary, and an empty
+// returned token means there is nothing older. Changes are backfill.
+type HistoryPager interface {
+	HistoryPage(ctx context.Context, pageToken string) (Changes, string, error)
+}
