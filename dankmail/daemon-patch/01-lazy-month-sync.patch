+// ListInboxRange returns the conversation IDs of inbox mail received in [from, to), newest first.
+func (c *Client) ListInboxRange(ctx context.Context, from, to time.Time) ([]string, error) {
+	f := "receivedDateTime ge " + from.UTC().Format("2006-01-02T15:04:05Z") + " and receivedDateTime lt " + to.UTC().Format("2006-01-02T15:04:05Z")
+	u := graphBase + "/me/mailFolders/inbox/messages?$select=id,conversationId&$top=100&$orderby=" + url.QueryEscape("receivedDateTime desc") + "&$filter=" + url.QueryEscape(f)
+	ids := []string{}
+	seen := map[string]bool{}
+	for u != "" {
+		var doc struct {
+			Value    []wireMessage `json:"value"`
+			NextLink string        `json:"@odata.nextLink"`
+		}
+		if err := c.do(ctx, http.MethodGet, u, nil, &doc); err != nil {
+			return nil, err
+		}
+		for _, m := range doc.Value {
+			if m.ConversationID != "" && !seen[m.ConversationID] {
+				ids = append(ids, m.ConversationID)
+				seen[m.ConversationID] = true
+			}
+		}
+		u = doc.NextLink
+	}
+	return ids, nil
+}
diff -ruN -x bin orig/dankmail-0.3.11/core/internal/provider/microsoft/history.go dankmail-0.3.11/core/internal/provider/microsoft/history.go
--- orig/dankmail-0.3.11/core/internal/provider/microsoft/history.go	1970-01-01 05:00:00.000000000 +0500
+++ dankmail-0.3.11/core/internal/provider/microsoft/history.go	2026-10-08 06:04:31.569951947 +0500
@@ -0,0 +1,70 @@
+package microsoft
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/arqueon/dankmail/core/internal/provider"
+)
+
+type rangeAPI interface {
+	ListInboxRange(ctx context.Context, from, to time.Time) ([]string, error)
+}
+
+const historyFloor = 2000
+
+// HistoryPage loads one older month of inbox mail (backfill, never notified).
+// The token is the exclusive upper bound (RFC3339) of the window to load; ""
+// starts just before the last 7 days. The returned token is the next window's
+// upper bound, or "" when the mailbox history is exhausted.
+func (p *Provider) HistoryPage(ctx context.Context, pageToken string) (provider.Changes, string, error) {
+	api, ok := p.api.(rangeAPI)
+	if !ok {
+		return provider.Changes{}, pageToken, fmt.Errorf("history unavailable")
+	}
+	to := time.Time{}
+	if pageToken == "" {
+		now := time.Now().UTC()
+		d := now.AddDate(0, 0, -7)
+		to = time.Date(d.Year(), d.Month(), d.Day(), 0, 0, 0, 0, time.UTC)
+	} else {
+		var err error
+		if to, err = time.Parse(time.RFC3339, pageToken); err != nil {
+			return provider.Changes{}, pageToken, fmt.Errorf("invalid history cursor")
+		}
+	}
+	changes := provider.Changes{Backfill: true}
+	// Skip over empty months so one request always yields something (or reaches the floor).
+	for tries := 0; tries < 12 && to.Year() >= historyFloor; tries++ {
+		from := to.AddDate(0, -1, 0)
+		ids, err := api.ListInboxRange(ctx, from, to)
+		if err != nil {
+			return changes, to.Format(time.RFC3339), classify(err)
+		}
+		for _, id := range ids {
+			messages, err := p.api.ListConversation(ctx, id)
+			if isNotFound(err) {
+				continue
+			}
+			var d provider.ThreadDelta
+			if err == nil {
+				d, err = p.threadDelta(ctx, id, messages)
+			}
+			if err != nil {
+				return changes, to.Format(time.RFC3339), classify(err)
+			}
+			if d.MessageCount > 0 {
+				changes.Upserted = append(changes.Upserted, d)
+			}
+		}
+		to = from
+		if len(changes.Upserted) > 0 {
+			break
+		}
+	}
+	if to.Year() < historyFloor {
+		return changes, "", nil
+	}
+	return changes, to.Format(time.RFC3339), nil
+}
