+// ListInboxRange returns the conversation IDs of inbox mail received in [from, to), newest first.
+func (c *Client) ListInboxRange(ctx context.Context, from, to time.Time) ([]string, error) {
+	f := "receivedDateTime ge " + from.UTC().Format("2006-01-02T15:04:05Z") + " and receivedDateTime lt " + to.UTC().Format("2006-01-02T15:04:05Z")
+	u := graphBase + "/me/mailFolders/inbox/messages?$select=id,conversationId&$top=100&$orderby=" + url.QueryEscape("receivedDateTime desc") + "&$filter=" + url.QueryEscape(f)
+	ids := []string{}
+	seen := map[string]bool{}
+	for u != "" {
+		var doc struct {
+			Value    []wireMessage `json:"value"`
+			NextLink string        `json:"@odata.nextLink"`
+		}
+		if err := c.do(ctx, http.MethodGet, u, nil, &doc); err != nil {
+			return nil, err
+		}
+		for _, m := range doc.Value {
+			if m.ConversationID != "" && !seen[m.ConversationID] {
+				ids = append(ids, m.ConversationID)
+				seen[m.ConversationID] = true
+			}
+		}
+		u = doc.NextLink
+	}
+	return ids, nil
+}
+
+type htmlBodyKey struct{}
+
+// withHTMLBody makes requests on ctx ask Graph for the html body instead of text.
+func withHTMLBody(ctx context.Context) context.Context {
+	return context.WithValue(ctx, htmlBodyKey{}, true)
+}
+
+// MessageHTML returns the raw html body of one message ("" when the body is
+// plain text). Fetched on demand, never stored.
+func (p *Provider) MessageHTML(ctx context.Context, _, messageID string) (string, error) {
+	m, err := p.api.GetMessage(withHTMLBody(ctx), messageID)
+	if err != nil {
+		return "", err
+	}
+	return m.BodyHTML, nil
+}
