+// MessageHTML returns the original text/html part of one message ("" when
+// the message is plain text only). Fetched on demand, never stored.
+func (p *Provider) MessageHTML(ctx context.Context, threadID, messageID string) (string, error) {
+	t, err := p.api.GetThread(ctx, threadID)
+	if err != nil {
+		return "", classify(err)
+	}
+	for _, m := range t.Messages {
+		if m.Id == messageID {
+			return firstHTML(m.Payload), nil
+		}
+	}
+	return "", nil
+}
+
+const historyFloor = 2000
+
+// HistoryPage loads one older month of inbox mail (backfill, never notified),
+// like the Microsoft provider. The token is the exclusive upper bound (RFC3339)
+// of the window to load; "" starts just before the last 7 days (the initial
+// sync window). The returned token is the next window's upper bound, or ""
+// when the mailbox history is exhausted.
+func (p *Provider) HistoryPage(ctx context.Context, pageToken string) (provider.Changes, string, error) {
+	ctx = withRetryBudget(ctx)
+	to := time.Time{}
+	if pageToken == "" {
+		d := time.Now().UTC().AddDate(0, 0, -7)
+		to = time.Date(d.Year(), d.Month(), d.Day(), 0, 0, 0, 0, time.UTC)
+	} else {
+		var err error
+		if to, err = time.Parse(time.RFC3339, pageToken); err != nil {
+			return provider.Changes{}, pageToken, fmt.Errorf("invalid history cursor")
+		}
+	}
+	changes := provider.Changes{Backfill: true}
+	// Skip over empty months so one request always yields something (or reaches the floor).
+	for tries := 0; tries < 12 && to.Year() >= historyFloor; tries++ {
+		from := to.AddDate(0, -1, 0)
+		query := fmt.Sprintf("in:inbox after:%d before:%d", from.Unix(), to.Unix())
+		page := ""
+		for {
+			ids, next, err := p.api.SearchThreads(ctx, query, page, 100)
+			if err != nil {
+				return changes, to.Format(time.RFC3339), classify(err)
+			}
+			for _, id := range ids {
+				t, err := p.api.GetThread(ctx, id)
+				if err != nil {
+					if isNotFound(err) {
+						continue
+					}
+					return changes, to.Format(time.RFC3339), classify(err)
+				}
+				if d := p.threadDelta(t); d.MessageCount > 0 {
+					changes.Upserted = append(changes.Upserted, d)
+				}
+			}
+			if next == "" {
+				break
+			}
+			page = next
+		}
+		to = from
+		if len(changes.Upserted) > 0 {
+			break
+		}
+	}
+	if to.Year() < historyFloor {
+		return changes, "", nil
+	}
+	return changes, to.Format(time.RFC3339), nil
+}
