// Let members of the docker group start/stop Docker's units without a password (docker group is already root-equivalent).
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        (action.lookup("unit") == "docker.service" || action.lookup("unit") == "docker.socket") &&
        subject.isInGroup("docker")) {
        return polkit.Result.YES;
    }
});
